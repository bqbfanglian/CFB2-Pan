{
  "name": "cfb2-pan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler d1 migrations apply DB --local --config config/wrangler.demo.jsonc --persist-to .wrangler/state && wrangler dev --local --config config/wrangler.demo.jsonc --persist-to .wrangler/state",
    "check": "tsc --noEmit && node --check public/drive.js && node --check public/share.js",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "fast-xml-parser": "^5.3.4",
    "jose": "^6.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.50.0"
  }
}
